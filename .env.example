APP_NAME=Xvond Core
APP_VERSION=1.0.0
APP_ENV=development

POSTGRES_USER=xvond
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=xvond
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://xvond:replace-with-a-strong-password@localhost:5432/xvond

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=xvond-core
JWT_AUDIENCE=xvond-users
ACCESS_TOKEN_EXPIRE_MINUTES=60

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password
SUPERADMIN_FULL_NAME=Xvond Super Admin

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
