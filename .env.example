APP_NAME=Xvond Core
APP_VERSION=1.0.0
APP_ENV=development

# Local Windows/Python runtime.
DATABASE_URL=postgresql+psycopg://xvond:URL_ENCODED_PASSWORD@127.0.0.1:5432/xvond

# Production Compose runtime. The database hostname must remain "postgres".
DATABASE_URL_DOCKER=postgresql+psycopg://xvond:URL_ENCODED_PASSWORD@postgres:5432/xvond
POSTGRES_USER=xvond
POSTGRES_PASSWORD=CHANGE_TO_A_STRONG_DATABASE_PASSWORD
POSTGRES_DB=xvond
POSTGRES_PORT=5432
APP_PORT=8000

REDIS_URL=redis://127.0.0.1:6379/0
TRUST_PROXY_HEADERS=false

JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=xvond-core
JWT_AUDIENCE=xvond-users
ACCESS_TOKEN_EXPIRE_MINUTES=60

CONFIG_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=CHANGE_TO_A_STRONG_ADMIN_PASSWORD
SUPERADMIN_FULL_NAME=Xvond Super Admin

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
